# Copy to .env and fill in, then: docker compose up -d
#   cp .env.example .env
#
# docker-compose.yml declares `env_file: - .env`, so the api container will
# refuse to start until this file exists. Never commit the filled-in .env:
# it is gitignored for a reason.

# ---------------------------------------------------------------------------
# LLM provider for NLP fingerprint extraction (nlp/src/extraction/llm.py)
# ---------------------------------------------------------------------------
# One of: openai | gemini | groq
# If this is unset the code defaults to gemini, and every extraction fails
# with "GEMINI_API_KEY is not set" while the API still returns 200. The
# fingerprint is then stored with extraction_status "failed" and the real
# error in `notes` -- check there first if extraction is not working.
LLM_PROVIDER=openai

# Needed only for the provider selected above.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
# GEMINI_API_KEY=
# GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Signs HSE staff JWTs. Any long random string; change it for anything real.
SECRET_KEY=dev-secret-change-me

# DATABASE_URL is set by docker-compose.yml and is not needed here.
