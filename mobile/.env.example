EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_USE_MOCK_VOICE_API=false
# Sanketak FastAPI backend. Use the LAN IP of the machine running Docker when
# testing on a physical phone -- localhost only resolves on the same machine
# or the iOS simulator. Example: http://192.168.1.24:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
